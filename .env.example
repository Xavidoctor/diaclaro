# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase.
# Están en Supabase → Project Settings → API Keys.
# Son públicos (los ve el navegador): la seguridad la dan las reglas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# IA gratuita de Groq (opcional). Crea la clave en https://console.groq.com → API Keys.
# Es secreta: solo vive en el servidor (Vercel → Settings → Environment Variables).
# Sin ella, la app funciona igual y no enseña el botón "Explícamelo con IA".
GROQ_API_KEY=
# Opcional: otro modelo de Groq (https://console.groq.com/docs/models).
GROQ_MODEL=
