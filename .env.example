# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase.
# Están en Supabase → Project Settings → API Keys.
# Son públicos (los ve el navegador): la seguridad la dan las reglas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# IA gratuita de Groq (opcional). Crea la clave en https://console.groq.com → API Keys.
# Es secreta: solo vive en el servidor (Vercel → Settings → Environment Variables).
# Sin ella, la app funciona igual y no enseña el botón "Explícamelo con IA".
GROQ_API_KEY=
# Opcional: otro modelo de Groq (https://console.groq.com/docs/models).
GROQ_MODEL=

# Google Calendar, solo lectura (opcional). Se crean en https://console.cloud.google.com
# (ver README, «Conectar Google Calendar»). El secreto solo vive en el servidor.
# Sin ellas, la app funciona igual y Ajustes dice que aún no está activado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Drive (opcional): clave de API para el selector de archivos, limitada
# a tu web y a "Google Picker API". Ver README, «Añadir Google Drive».
GOOGLE_PICKER_API_KEY=
# Cuentas de demostración (opcional): la contraseña de los usuarios
# demo1/2/3@example.com. Si está vacía, en /login no salen los botones Demo.
DEMO_PASSWORD=
